# The installer generates .env and .secrets.env with private file permissions.
CONNECTOR_DOMAIN=mcp.example.com
ACME_EMAIL=you@example.com
PUBLIC_URL=https://mcp.example.com
TRADING_ENABLED=true
AUTH_MODE=secret_path
# In .secrets.env (literal KEY=value format, never quote or source the file):
# BITPIN_API_KEY=...
# BITPIN_SECRET_KEY=...
# CONNECTOR_PASSWORD_HASH=scrypt:... (generated by setup)
# CONNECTOR_API_TOKEN=... (generated by setup, optional for API clients)
# MCP_SECRET_PATH=/mcp-... (randomly generated, do not share)
